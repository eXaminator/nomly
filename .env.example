# --- Required ---

# Public base URL (used for OIDC redirect URI + cookie scope).
BASE_URL=http://localhost:3000

# Encrypts the session cookie. Must be at least 32 characters.
SESSION_SECRET=replace-me-with-32-or-more-character-string

# OIDC issuer (Authentik, Keycloak, etc.). Must end in `/`.
OIDC_ISSUER=https://auth.example.com/application/o/nomly/
OIDC_CLIENT_ID=nomly
OIDC_CLIENT_SECRET=replace-me

# --- Optional ---

# RP-initiated logout endpoint at the IdP. If unset, /api/auth/logout
# only clears the local session cookie.
# OIDC_END_SESSION_URL=https://auth.example.com/application/o/nomly/end-session/

# SQLite path. Defaults to ./data/nomly.db.
# DATABASE_URL=./data/nomly.db

# HTTP port and bind address.
# PORT=3000
# HOSTNAME=0.0.0.0
